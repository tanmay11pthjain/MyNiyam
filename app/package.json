{
  "name": "myniyam-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/check-port.mjs 3100 && next dev -p 3100",
    "build": "next build",
    "start": "node scripts/check-port.mjs && next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:up": "docker compose up -d db",
    "db:migrate": "node --env-file-if-exists=.env.local scripts/db.mjs migrate",
    "db:seed": "node --env-file-if-exists=.env.local scripts/db.mjs seed",
    "db:seed:dev": "node --env-file-if-exists=.env.local scripts/db.mjs seed:dev",
    "db:reset": "node --env-file-if-exists=.env.local scripts/db.mjs reset"
  },
  "dependencies": {
    "jose": "^6.2.13",
    "jsqr": "^1.4.0",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22"
  }
}
