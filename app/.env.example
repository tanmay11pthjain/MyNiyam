# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# Everything here is read only by server code. Nothing is prefixed NEXT_PUBLIC_, so nothing reaches the browser.

# Postgres. Local dev: the Docker database from `npm run db:up`.
# Supabase (Mumbai, ap-south-1): Project Settings → Database → Connection string → "Transaction pooler" (port 6543).
DATABASE_URL=postgres://postgres:myniyam-local@127.0.0.1:54329/myniyam
DB_POOL_MAX=5

# 32+ random characters. Signs the session cookie and hashes OTPs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# MSG91 (https://control.msg91.com). SMS needs a DLT-approved OTP template; its id goes here.
MSG91_AUTH_KEY=
MSG91_SMS_TEMPLATE_ID=
# WhatsApp: your integrated number (with 91, no +), an approved "authentication" template with the
# code in the body ({{1}}) and a copy-code button, and its namespace if MSG91 shows one.
MSG91_WHATSAPP_NUMBER=
MSG91_WHATSAPP_TEMPLATE=
MSG91_WHATSAPP_NAMESPACE=
MSG91_WHATSAPP_LANGUAGE=en

# How login codes are delivered:
#   simulate (default): nothing is sent and the code is always 1234. For now, while SMS/WhatsApp is postponed.
#   msg91: a random 4-digit code is sent by MSG91 (needs the MSG91_* values above).
# Rate limits, expiry and wrong-try counters work the same in both modes.
# With NODE_ENV=production the server refuses "simulate" unless ALLOW_OTP_SIMULATION_IN_PRODUCTION=true.
OTP_DELIVERY=simulate
# Public demo with simulated codes (ALLOW_OTP_SIMULATION_IN_PRODUCTION=true): only these numbers can log in.
# DEMO_PHONES=+919999900001,+917000000001

# Admin panel (/admin)
# The super admin approves new pathshalas and assigns their admins. +91 number(s), comma-separated.
SUPER_ADMIN_PHONE=
# ADMIN_SESSION_IDLE_DAYS=30   # an admin is logged out after this many days without using the panel

# Logo and profile photo storage: a PRIVATE Supabase Storage bucket, reached by the server only.
# Supabase → Project Settings → API: the project URL and the service_role key (secret; never NEXT_PUBLIC_).
# Leave empty on your own computer: files then go to .data/storage (local dev only; refused in production).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=myniyam
# MAX_UPLOAD_BYTES=600000      # pictures are shrunk to 512 px in the browser first

# Limits (defaults shown)
# OTP_TTL_SEC=300
# OTP_SENDS_PER_WINDOW=3
# OTP_WINDOW_SEC=600
# OTP_RESEND_AFTER_SEC=30
# OTP_MAX_ATTEMPTS=5
# RL_OTP_SEND_PER_IP_HOUR=20
# RL_VERIFY_PER_IP_HOUR=60
# RL_LOOKUP_PER_IP_MIN=30
# MAX_PROFILES_PER_ACCOUNT=8
# SESSION_DAYS=60
# RL_ADMIN_PER_IP_MIN=120

# Privacy notice: the person members contact with questions or complaints (DPDP grievance officer).
GRIEVANCE_NAME=Tanmay Dhelariya
GRIEVANCE_EMAIL=
GRIEVANCE_PHONE=

# Reminders (web push). Make the pair once: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
# The reminder job must send "Authorization: Bearer <CRON_SECRET>". 24+ random characters.
CRON_SECRET=

# Error alerts (optional): the DSN of a free Sentry project.
SENTRY_DSN=
