{
  "rules": {
    "settings": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    },
    "sangh_settings": {
      ".read": "auth != null",
      "$code": {
        ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
      }
    },
    "users": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && (auth.uid === $uid || $uid.beginsWith(auth.uid + '__p') || root.child('users').child(auth.uid).child('role').val() === 'admin')",
        "role": {
          ".validate": "newData.val() === 'user' || root.child('users').child(auth.uid).child('role').val() === 'admin'"
        },
        "sanghCodes": {
          ".validate": false
        }
      }
    },
    "sangh_users": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "account_profiles": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "sanghs": {
      ".read": "auth != null",
      ".write": false
    },
    "stats": {
      ".read": true,
      ".write": "auth != null && root.child('users').child(auth.uid).child('role').val() === 'admin'"
    }
  }
}
